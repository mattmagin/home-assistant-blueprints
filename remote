                                  target:
                                    entity_id: "{{ repeat.item }}"
                                  data:
                                    color_temp_kelvin: "{{ up_color_temp_kelvin }}"
                                    transition: "{{ up_light_auto_adjust_transition }}"
          - if:
              - "{{ down_has_light }}"
              - "{{ down_light_auto_adjust_brightness or down_light_auto_adjust_color_temp }}"
              - "{{ down_adjustment_mode == 'adaptive' or (down_adjustment_mode == 'schedule' and down_schedule not in [none, '', []]) }}"
            then:
              - repeat:
                  for_each: "{{ down_light_entities }}"
                  sequence:
                    - if:
                        - "{{ is_state(repeat.item, 'on') }}"
                      then:
                        - choose:
                            - conditions: "{{ down_light_auto_adjust_brightness and down_light_auto_adjust_color_temp }}"
                              sequence:
                                - action: light.turn_on
                                  target:
                                    entity_id: "{{ repeat.item }}"
                                  data:
                                    brightness_pct: "{{ down_brightness_pct }}"
                                    color_temp_kelvin: "{{ down_color_temp_kelvin }}"
