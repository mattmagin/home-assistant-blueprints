                            - conditions: "{{ down_light_auto_adjust_brightness }}"
                              sequence:
                                - action: light.turn_on
                                  target:
                                    entity_id: "{{ repeat.item }}"
                                  data:
                                    brightness_pct: "{{ down_brightness_pct }}"
                                    transition: "{{ down_light_auto_adjust_transition }}"
                            - conditions: "{{ down_light_auto_adjust_color_temp }}"
                              sequence:
                                - action: light.turn_on
                                  target:
                                    entity_id: "{{ repeat.item }}"
                                  data:
                                    color_temp_kelvin: "{{ down_color_temp_kelvin }}"
                                    transition: "{{ down_light_auto_adjust_transition }}"
          - if:
              - "{{ hue_has_light }}"
              - "{{ hue_light_auto_adjust_brightness or hue_light_auto_adjust_color_temp }}"
              - "{{ hue_adjustment_mode == 'adaptive' or (hue_adjustment_mode == 'schedule' and hue_schedule not in [none, '', []]) }}"
