                            - conditions: "{{ up_light_auto_adjust_brightness and up_light_auto_adjust_color_temp }}"
                              sequence:
                                - action: light.turn_on
                                  target:
                                    entity_id: "{{ repeat.item }}"
                                  data:
                                    brightness_pct: "{{ up_brightness_pct }}"
                                    color_temp_kelvin: "{{ up_color_temp_kelvin }}"
                                    transition: "{{ up_light_auto_adjust_transition }}"
                            - conditions: "{{ up_light_auto_adjust_brightness }}"
