                                    entity_id: "{{ repeat.item }}"
                                  data:
                                    color_temp_kelvin: "{{ power_color_temp_kelvin }}"
                                    transition: "{{ power_light_auto_adjust_transition }}"
          - if:
              - "{{ up_has_light }}"
              - "{{ up_light_auto_adjust_brightness or up_light_auto_adjust_color_temp }}"
              - "{{ up_adjustment_mode == 'adaptive' or (up_adjustment_mode == 'schedule' and up_schedule not in [none, '', []]) }}"
