max_exceeded: silent
trigger_variables:
  z2m_base_topic: !input z2m_base_topic
  z2m_device_name: !input z2m_device_name
variables:
  integration_type: !input integration_type
  zha_remote: !input zha_remote
  z2m_base_topic: !input z2m_base_topic
  z2m_device_name: !input z2m_device_name
  last_pressed: !input last_pressed
  zha_command: "{{ trigger.event.data.command if trigger.event is defined else '' }}"
  z2m_action: "{{ trigger.payload_json.action | default('') if trigger.payload_json is defined else '' }}"
  command: |-
    {% if zha_command != '' %}
      {% if zha_command.startswith('on_') %}power_{{ zha_command[3:] }}
      {% elif zha_command.startswith('off_') %}hue_{{ zha_command[4:] }}
      {% else %}{{ zha_command }}
      {% endif %}
    {% elif z2m_action != '' %}
      {% if z2m_action == 'on_press' %}power_press
      {% elif z2m_action == 'on_press_release' %}power_short_release
      {% elif z2m_action == 'on_hold' %}power_hold
      {% elif z2m_action == 'on_hold_release' %}power_long_release
      {% elif z2m_action == 'up_press' %}up_press
      {% elif z2m_action == 'up_press_release' %}up_short_release
      {% elif z2m_action == 'up_hold' %}up_hold
      {% elif z2m_action == 'up_hold_release' %}up_long_release
      {% elif z2m_action == 'down_press' %}down_press
      {% elif z2m_action == 'down_press_release' %}down_short_release
      {% elif z2m_action == 'down_hold' %}down_hold
      {% elif z2m_action == 'down_hold_release' %}down_long_release
      {% elif z2m_action == 'off_press' %}hue_press
      {% elif z2m_action == 'off_press_release' %}hue_short_release
      {% elif z2m_action == 'off_hold' %}hue_hold
      {% elif z2m_action == 'off_hold_release' %}hue_long_release
      {% elif z2m_action in ['recall_0', 'recall_1'] %}hue_short_release
      {% else %}{{ z2m_action }}
      {% endif %}
    {% else %}
    {% endif %}
  event_button: |-
    {% if command.startswith('power_') %}power
    {% elif command.startswith('up_') %}up
    {% elif command.startswith('down_') %}down
    {% elif command.startswith('hue_') %}hue
    {% else %}{% endif %}
  z2m_button: "{{ {'power': 'on', 'up': 'up', 'down': 'down', 'hue': 'off'}.get(event_button, '') }}"
  power_light: !input power_light
  power_adjustment_mode: !input power_light_adjustment_mode
  power_adaptive_brightness: !input power_light_adaptive_brightness
  power_adaptive_color_temp: !input power_light_adaptive_color_temp
  power_schedule: !input power_light_schedule
  power_brightness_input: !input power_light_brightness
  power_color_input: !input power_light_color
  power_transition_input: !input power_light_transition
  power_brightness_pct: |-
    {% if power_adjustment_mode == 'adaptive' %}
      {% if power_adaptive_brightness not in [none, '', []] %}
        {{ states(power_adaptive_brightness) | int(power_brightness_input) }}
      {% else %}
        {{ power_brightness_input }}
      {% endif %}
    {% elif power_adjustment_mode == 'schedule' %}
      {% if power_schedule not in [none, '', []] %}
        {% set val = state_attr(power_schedule, 'brightness_pct') %}
        {{ val if val is not none else power_brightness_input }}
      {% else %}
        {{ power_brightness_input }}
      {% endif %}
    {% else %}
      {{ power_brightness_input }}
    {% endif %}
  power_color_temp_kelvin: |-
    {% if power_adjustment_mode == 'adaptive' %}
      {% if power_adaptive_color_temp not in [none, '', []] %}
        {{ states(power_adaptive_color_temp) | int(power_color_input) }}
      {% else %}
        {{ power_color_input }}
      {% endif %}
    {% elif power_adjustment_mode == 'schedule' %}
      {% if power_schedule not in [none, '', []] %}
        {% set val = state_attr(power_schedule, 'color_temp_kelvin') %}
        {{ val if val is not none else power_color_input }}
      {% else %}
        {{ power_color_input }}
      {% endif %}
    {% else %}
      {{ power_color_input }}
    {% endif %}
  power_transition: |-
    {% if power_adjustment_mode == 'schedule' %}
      {% if power_schedule not in [none, '', []] %}
        {{ state_attr(power_schedule, 'transition') | default(power_transition_input, true) | float }}
      {% else %}
        {{ power_transition_input | float }}
      {% endif %}
    {% else %}
      {{ power_transition_input | float }}
    {% endif %}
  power_short_release_light_mode: !input power_short_release_light_mode
  power_long_release_light_mode: !input power_long_release_light_mode
  power_double_light_mode: !input power_double_light_mode
  power_has_light: "{{ power_light.entity_id | default([]) | length > 0 or power_light.device_id | default([]) | length > 0 or power_light.area_id | default([]) | length > 0 or power_light.label_id | default([]) | length > 0 }}"
  power_short_release_reset_brightness: !input power_short_release_reset_brightness
  power_short_release_reset_color: !input power_short_release_reset_color
  power_long_release_reset_brightness: !input power_long_release_reset_brightness
  power_long_release_reset_color: !input power_long_release_reset_color
  power_light_auto_adjust_brightness: !input power_light_auto_adjust_brightness
  power_light_auto_adjust_color_temp: !input power_light_auto_adjust_color_temp
  power_light_auto_adjust_transition: !input power_light_auto_adjust_transition
  power_light_entities: |-
    {% set ns = namespace(entities=[]) %}
    {% if power_light.entity_id is defined and power_light.entity_id | length > 0 %}
      {% if power_light.entity_id is string %}
        {% set ns.entities = [power_light.entity_id] %}
      {% else %}
        {% set ns.entities = power_light.entity_id %}
      {% endif %}
    {% elif power_light.device_id is defined and power_light.device_id | length > 0 %}
      {% set devices = [power_light.device_id] if power_light.device_id is string else power_light.device_id %}
      {% for device in devices %}
        {% set ns.entities = ns.entities + device_entities(device) | select('match', '^light\.') | list %}
      {% endfor %}
    {% elif power_light.area_id is defined and power_light.area_id | length > 0 %}
      {% set areas = [power_light.area_id] if power_light.area_id is string else power_light.area_id %}
      {% for area in areas %}
        {% set ns.entities = ns.entities + area_entities(area) | select('match', '^light\.') | list %}
      {% endfor %}
    {% elif power_light.label_id is defined and power_light.label_id | length > 0 %}
      {% set labels = [power_light.label_id] if power_light.label_id is string else power_light.label_id %}
      {% for label in labels %}
        {% set ns.entities = ns.entities + label_entities(label) | select('match', '^light\.') | list %}
      {% endfor %}
    {% endif %}
    {{ ns.entities }}
  up_light: !input up_light
  up_adjustment_mode: !input up_light_adjustment_mode
